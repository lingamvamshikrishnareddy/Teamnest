# ---------------------------------------------------------------
# TeamNest environment config. Copy to .env.local (web) / .env (mobile).
# APP_ENV selects behaviour: local | staging | production
# ---------------------------------------------------------------
APP_ENV=local

# Supabase (local defaults from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only (Edge Functions / server actions). Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Maps (Mapbox public token)
NEXT_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_MAPBOX_TOKEN=

# Field-level encryption key lives in Supabase Vault as `teamnest_encryption_key`
# (local dev uses the app.encryption_key database setting instead).

# Direct Postgres connection for `pnpm db:seed` (Supabase: Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Edge Function secrets (supabase secrets set ...) ----
# PAYMENT_PROVIDER=mock (dev, default) | razorpay (production)
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=whsec_local
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOWED_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
# Optional delivery channels for notifications-dispatch
RESEND_API_KEY=
MAIL_FROM=TeamNest <no-reply@example.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Mobile build config (EAS)
EAS_PROJECT_ID=
GOOGLE_MAPS_ANDROID_KEY=
