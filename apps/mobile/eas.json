{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "APP_ENV": "local" } },
    "staging": { "distribution": "internal", "channel": "staging", "env": { "APP_ENV": "staging" } },
    "production": { "channel": "production", "autoIncrement": true, "env": { "APP_ENV": "production" } }
  },
  "submit": { "production": {} }
}
