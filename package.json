{
  "name": "teamnest",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @teamnest/web dev",
    "dev:mobile": "pnpm --filter @teamnest/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "db:test": "./scripts/db-test.sh",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:reset": "supabase db reset",
    "db:start": "supabase start"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "~5.6.3"
  }
}
